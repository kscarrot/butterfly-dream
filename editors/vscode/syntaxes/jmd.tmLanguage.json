{
  "name": "JMD",
  "scopeName": "source.jmd",
  "patterns": [
    { "include": "#frontmatter" },
    { "include": "#soft-join" },
    { "include": "#entity" },
    { "include": "#revision" },
    { "include": "#footnote" },
    { "include": "#styled-span" },
    { "include": "text.html.markdown" }
  ],
  "repository": {
    "frontmatter": {
      "name": "meta.frontmatter.jmd",
      "begin": "^\\+\\+\\+$",
      "end": "^\\+\\+\\+$",
      "contentName": "source.toml"
    },
    "soft-join": {
      "name": "keyword.operator.soft-join.jmd",
      "match": "\\\\\\s*$"
    },
    "entity": {
      "name": "meta.entity.jmd",
      "match": "[@&#$]\\[[^\\]]+\\]",
      "captures": {
        "0": { "name": "entity.name.jmd" }
      }
    },
    "revision": {
      "name": "meta.revision.jmd",
      "match": "\\[\\^c:[a-zA-Z0-9_-]+\\]",
      "captures": {
        "0": { "name": "entity.name.tag.revision.jmd" }
      }
    },
    "footnote": {
      "name": "meta.footnote.jmd",
      "match": "\\[\\^(?!c:)[a-zA-Z0-9_-]+\\]",
      "captures": {
        "0": { "name": "entity.name.tag.footnote.jmd" }
      }
    },
    "styled-span": {
      "name": "meta.styled-span.jmd",
      "match": "\\[[^\\]]+\\]\\{\\.[^}]+\\}",
      "captures": {
        "0": { "name": "markup.italic.jmd" }
      }
    }
  }
}
